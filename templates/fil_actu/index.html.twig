{% extends 'base.html.twig' %}

{% block title %}Mon Fil d'actualité - Kwikker{% endblock %}

{% block body %}
    <style>
        body {
            background-color: #aebcae;
            color: #2f3e2e;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            margin: 0;
            display: flex;
            justify-content: center;
            min-height: 100vh;
        }

        .feed-container {
            background-color: #f0f4f0;
            width: 100%;
            max-width: 600px;
            min-height: 100vh;
            padding: 20px;
            box-sizing: border-box;
            box-shadow: 0 0 20px rgba(0,0,0,0.1);
        }

        /* --- TABS & SEARCH CONTAINER --- */
        .tabs-container {
            display: flex;
            align-items: center; /* Aligne verticalement les boutons et la barre */
            justify-content: center;
            gap: 15px;
            margin-bottom: 25px;
            flex-wrap: wrap; /* Permet de passer à la ligne sur mobile */
        }

        .tab-btn {
            padding: 10px 18px;
            border-radius: 12px;
            text-decoration: none;
            font-weight: bold;
            font-size: 0.9rem;
            box-shadow: 0 4px 8px rgba(0,0,0,0.2);
            transition: all 0.2s ease;
        }

        .tab-btn:hover {
            transform: translateY(-2px);
            filter: brightness(1.2);
        }

        /* Couleurs des boutons plus foncées */
        .tab-active {
            background-color: #1a241a;
            color: white;
        }

        .tab-inactive {
            background-color: #4a5c4a;
            color: white;
        }

        /* --- BARRE DE RECHERCHE --- */
        .tabs-container form {
            display: flex;
            background: white;
            border: 1px solid #d1d9d1;
            border-radius: 12px;
            padding: 4px 8px;
            box-shadow: 0 2px 6px rgba(0,0,0,0.05);
            flex-grow: 1; /* Prend l'espace disponible */
            max-width: 250px;
        }

        .tabs-container input[type="text"] {
            border: none;
            outline: none;
            padding: 6px;
            font-size: 0.9rem;
            width: 100%;
            background: transparent;
            color: #2f3e2e;
        }

        .tabs-container button[type="submit"] {
            background: none;
            border: none;
            cursor: pointer;
            font-size: 1.1rem;
            padding: 0 5px;
            transition: transform 0.2s;
        }

        .tabs-container button[type="submit"]:hover {
            transform: scale(1.2);
        }

        .tabs-container a[href="{{ path('app_fil_actu') }}"] {
            text-decoration: none;
            color: #aebcae;
            font-weight: bold;
            display: flex;
            align-items: center;
            padding: 0 5px;
            font-size: 0.8rem;
        }

        .tabs-container a[href="{{ path('app_fil_actu') }}"]:hover {
            color: #cc0000;
        }

        /* --- PAGINATION --- */
        .pagination {
            display: flex;
            justify-content: center;
            gap: 15px;
            margin-top: 30px;
            padding: 20px 0;
            border-top: 1px solid #d1d9d1;
        }

        /* --- CARDS --- */
        .kweek-card {
            background-color: #ffffff;
            padding: 20px;
            border-radius: 20px;
            margin-bottom: 20px;
            border: 1px solid #d1d9d1;
            transition: transform 0.2s ease, box-shadow 0.2s ease;
        }

        .kweek-card:hover {
            transform: translateY(-2px);
            border-color: #aebcae;
            box-shadow: 0 5px 15px rgba(0,0,0,0.05);
        }

        .kweek-author {
            font-family: 'Courier New', Courier, monospace;
            font-weight: bold;
            text-decoration: none;
            color: #5c6b5c;
            background-color: #e8eee8;
            padding: 4px 12px;
            border-radius: 15px;
            font-size: 0.85rem;
            display: inline-block;
            margin-bottom: 10px;
            transition: all 0.2s;
        }

        .kweek-author:hover {
            background-color: #2f3e2e;
            color: #ffffff;
        }

        .kweek-content {
            font-size: 1.05rem;
            line-height: 1.5;
            margin: 10px 0;
            color: #333;
        }

        .kweek-stats {
            display: flex;
            gap: 15px;
            margin-top: 15px;
            padding-top: 10px;
            border-top: 1px dashed #aebcae;
        }

        .stat-item {
            display: flex;
            align-items: center;
            gap: 5px;
            font-size: 0.85rem;
            color: #5c6b5c;
            background-color: #f9fbf9;
            padding: 4px 10px;
            border-radius: 8px;
        }

        .stat-item a {
            text-decoration: none;
        }

        .no-posts {
            text-align: center;
            padding: 50px;
            color: #5c6b5c;
            font-style: italic;
        }

        /* --- PROFILE FLOATING --- */
        .profile-floating {
            position: fixed;
            top: 20px;
            right: 20px;
            text-align: center;
            z-index: 999;
        }

        .profile-btn {
            background-color: #2f3e2e;
            color: #ffffff;
            font-size: 1.6rem;
            text-decoration: none;
            padding: 12px 16px;
            border-radius: 50%;
            display: inline-block;
            box-shadow: 0 4px 10px rgba(0,0,0,0.2);
            transition: all 0.2s ease;
        }

        .profile-btn:hover {
            background-color: #5c6b5c;
            transform: scale(1.1) rotate(5deg);
        }

        .profile-username {
            margin-top: 6px;
            font-size: 0.85rem;
            color: #2f3e2e;
            font-family: 'Courier New', monospace;
            background-color: #e8eee8;
            padding: 3px 8px;
            border-radius: 10px;
            border: 1px solid #d1d9d1;
        }
    </style>

    {% if app.user %}
        <div class="profile-floating">
            <a href="{{ path('user_profile', { id: app.user.id }) }}" class="profile-btn">👤</a>
            <div class="profile-username">@{{ app.user.pseudo }}</div>
        </div>
    {% endif %}

    <div class="feed-container">

        <div class="tabs-container">
            <a href="{{ path('app_fil_actu', { tab: 'feed' }) }}"
               class="tab-btn {{ tab == 'feed' ? 'tab-active' : 'tab-inactive' }}">
                Fil d'actualités
            </a>

            <form action="{{ path('app_fil_actu') }}" method="get" style="margin-bottom: 20px; display: flex; gap: 10px;">
                <input type="text"
                       name="search"
                       placeholder="Rechercher un Kweek..."
                       value="{{ searchTerm }}">
                <button type="submit">🔍</button>

                {% if searchTerm %}
                    <a href="{{ path('app_fil_actu') }}">✖</a>
                {% endif %}
            </form>

            <a href="{{ path('app_fil_actu', { tab: 'trending' }) }}"
               class="tab-btn {{ tab == 'trending' ? 'tab-active' : 'tab-inactive' }}">
                Tendances
            </a>
        </div>

        {% set limit = 20 %}
        {% set offset = (currentPage - 1) * limit %}

        {% for post in posts|slice(offset, limit) %}
            <div class="kweek-card">
                <a href="{{ path('user_profile', {id: post.author.id}) }}" class="kweek-author">
                    @{{ post.author.pseudo }}
                </a>

                <p class="kweek-content">{{ post.ContenuDuKweek }}</p>

                <div class="kweek-stats">
                    <div class="stat-item">
                        <span>💬</span> {{ post.NombreDeCommentaires }}
                    </div>

                    <div class="stat-item">
                        {% if app.user %}
                            {% if post.isLikedBy(app.user) %}
                                <a href="{{ path('post_like', { id: post.id, from: 'feed' }) }}">❤️</a>
                            {% else %}
                                <a href="{{ path('post_like', { id: post.id, from: 'feed' }) }}">🤍</a>
                            {% endif %}
                        {% else %}
                            <span>🤍</span>
                        {% endif %}
                        <span>{{ post.likes|length }}</span>
                    </div>

                </div>
            </div>
        {% else %}
            <div class="no-posts">
                <p>Aucun kweek pour le moment.</p>
            </div>
        {% endfor %}

        <div class="pagination">
            {% if currentPage > 1 %}
                <a href="{{ path('app_fil_actu', app.request.query.all|merge({'page': currentPage - 1})) }}"
                   class="tab-btn tab-inactive">Page précédente</a>
            {% endif %}

            {% if posts|length > (offset + limit) %}
                <a href="{{ path('app_fil_actu', app.request.query.all|merge({'page': currentPage + 1})) }}"
                   class="tab-btn tab-inactive">Page suivante</a>
            {% endif %}
        </div>

    </div>
{% endblock %}
