{% extends 'base.html.twig' %}

{% block body %}
    {% block content %}

        <div class="main-container">
            <div class="card-custom">

                <div class="back-container">
                    <a href="{{ path('app_fil_actu') }}" class="back-btn">⬅ Retour</a>
                </div>

                <div class="profile-header">
                    <h1 class="brand-name">Profil de {{ user.pseudo }}</h1>

                    {% if app.user and app.user == user %}
                        <a href="{{ path('app_user_edit', {'id': user.id}) }}" class="edit-btn">
                            Modifier
                        </a>
                    {% endif %}
                </div>

                {% if user.bio %}
                    <p class="user-bio">{{ user.bio }}</p>
                {% endif %}

                {% if app.user and app.user != user %}
                    <div class="action-center">
                        {% if app.user.isFollowing(user) %}
                            <a href="{{ path('user_unfollow', { id: user.id }) }}" class="action-btn unfollow">Se désabonner</a>
                        {% else %}
                            <a href="{{ path('user_follow', { id: user.id }) }}" class="action-btn follow">S'abonner</a>
                        {% endif %}
                    </div>
                {% endif %}

                <div class="follow-stats-box">
                    <p><strong>{{ user.followers|length }}</strong> abonnés</p>
                    <p><strong>{{ user.following|length }}</strong> abonnements</p>
                </div>

                {% if app.user and app.user == user %}
                    <div class="action-center">
                        <a href="{{ path('app_create') }}" class="action-btn create">Créer un kweek</a>
                    </div>
                {% endif %}

                <h2 class="section-title">Kweeks</h2>

                {% for post in posts %}
                    <div class="tweet-box">
                        {{ post.ContenuDuKweek }}
                        <div class="action-buttons">
                            {# Bouton Modifier #}
                            <a href="{{ path('app_tweet_edit', { id: post.id }) }}" class="edit-btn">
                                Modifier
                            </a>

                            {# Bouton Supprimer #}
                            <form method="post" action="{{ path('app_tweet_delete', { id: post.id }) }}" onsubmit="return confirm('Êtes-vous sûr ?');" style="margin:0; width: 100%;">
                                <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ post.id) }}">
                                <button class="delete-btn">Supprimer</button>
                            </form>
                        </div>
                        <div class="like-zone">
                            {% if app.user %}
                                {% if post.isLikedBy(app.user) %}
                                    <a href="{{ path('post_like', { id: post.id, from: 'profile', userId: user.id }) }}" class="like-icon">❤️</a>
                                {% else %}
                                    <a href="{{ path('post_like', { id: post.id, from: 'profile', userId: user.id }) }}" class="like-icon">🤍</a>
                                {% endif %}
                            {% endif %}
                            <span class="like-count">{{ post.likes|length }}</span>
                        </div>
                    </div>
                {% else %}
                    <p class="empty-state">Aucun kweek pour le moment.</p>
                {% endfor %}

            </div>
        </div>

        <style>
                /* --- RAPPEL DES VARIABLES (Déjà présentes dans votre base, mises ici pour référence) --- */
            :root {
                --frozen-water: #D7F9F1;
                --muted-teal:   #7AA095;
                --olive-leaf:   #40531B;
                --fern:         #618B4A;
                --dry-sage:     #AFBC88;
            }

            /* --- CONTENEUR DES BOUTONS --- */
            /* Permet d'aligner "Modifier" et "Supprimer" proprement */
            .action-buttons {
                display: flex;
                align-items: center;
                gap: 12px; /* Espace entre les boutons */
                margin-top: 15px;
                padding-top: 15px;
                border-top: 1px dashed var(--dry-sage); /* Petite séparation subtile avec le texte */
            }

            /* --- BOUTON MODIFIER (Action principale) --- */
            .edit-btn {
                background-color: var(--fern); /* Vert Fougère vif */
                color: white;
                padding: 8px 16px;
                border-radius: 10px;
                text-decoration: none;
                font-size: 14px;
                font-weight: 600;
                transition: all 0.3s ease;
                border: none;
                display: inline-flex;
                align-items: center;
            }

            .edit-btn:hover {
                background-color: var(--olive-leaf); /* Devient plus sombre au survol */
                transform: translateY(-2px);
                box-shadow: 0 4px 8px rgba(97, 139, 74, 0.3);
            }

            /* --- BOUTON SUPPRIMER (Action secondaire/danger) --- */
            /* J'utilise un style "Ghost" (bordure seulement) pour éviter les clics accidentels */
            .delete-btn {
                background-color: transparent;
                color: var(--olive-leaf); /* Texte vert olive sombre */
                border: 2px solid var(--olive-leaf); /* Bordure visible */
                padding: 6px 14px;
                border-radius: 10px;
                font-size: 14px;
                font-weight: 600;
                cursor: pointer;
                transition: all 0.3s ease;
            }

            .delete-btn:hover {
                background-color: var(--olive-leaf); /* Se remplit au survol */
                color: var(--frozen-water); /* Texte devient clair */
                transform: translateY(-2px);
                box-shadow: 0 4px 8px rgba(64, 83, 27, 0.2);
            }

            /* Petit ajustement responsive pour mobile */
            @media (max-width: 600px) {
                .action-buttons {
                    flex-direction: column;
                    align-items: flex-start;
                }
                .edit-btn, .delete-btn {
                    width: 100%;
                    text-align: center;
                    justify-content: center;
                }
            }
            body, html {
                height: 100%;
                margin: 0;
                font-family: sans-serif;
            }

            .main-container {
                display: flex;
                justify-content: center;
                align-items: flex-start;
                min-height: 100vh;
                background-color: #ffffff;
                padding: 20px;
            }

            .card-custom {
                background-color: #aebcae;
                padding: 35px;
                border-radius: 20px;
                width: 100%;
                max-width: 450px;
                box-shadow: 0 4px 15px rgba(0,0,0,0.1);
                box-sizing: border-box;
                position: relative;
            }

            .back-container {
                position: absolute;
                top: 15px;
                left: 15px;
            }

            .back-btn {
                background: #2f3e2e;
                color: white;
                padding: 5px 10px;
                border-radius: 8px;
                text-decoration: none;
                font-size: 0.75rem;
                opacity: 0.8;
                transition: 0.2s ease;
            }

            .back-btn:hover {
                opacity: 1;
                background: #1f2a1f;
            }

            .profile-header {
                display: flex;
                justify-content: space-between;
                align-items: center;
                margin-bottom: 15px;
                border-bottom: 1px solid #eee;
                padding-bottom: 10px;
            }

            .brand-name {
                font-family: 'Comic Sans MS', 'Chalkboard SE', sans-serif;
                font-size: 2rem;
                color: #2f3e2e;
                font-weight: bold;
                margin: 0;
            }

            .edit-btn {
                text-decoration: none;
                background-color: #f0f0f0;
                color: #333;
                padding: 8px 15px;
                border-radius: 8px;
                font-weight: 600;
                font-size: 14px;
                border: 1px solid #ccc;
                transition: 0.2s;
            }

            .edit-btn:hover {
                background-color: #e0e0e0;
                color: black;
            }

            .user-bio {
                font-style: italic;
                color: #555;
                margin-bottom: 25px;
            }

            .action-center {
                display: flex;
                justify-content: center;
                margin-bottom: 20px;
            }

            .action-btn {
                padding: 10px 22px;
                border-radius: 12px;
                font-weight: 600;
                text-decoration: none;
                font-size: 15px;
                transition: 0.25s ease;
                text-align: center;
                display: inline-block;
            }

            .action-btn.follow {
                background: #6b8e23;
                color: white;
                box-shadow: 0 4px 10px rgba(107, 142, 35, 0.3);
            }

            .action-btn.follow:hover {
                background: #5c7c1f;
                transform: translateY(-2px);
            }

            .action-btn.unfollow {
                background: #ff7b00;
                color: white;
                box-shadow: 0 4px 10px rgba(255, 123, 0, 0.3);
            }

            .action-btn.unfollow:hover {
                background: #e86e00;
                transform: translateY(-2px);
            }

            .action-btn.create {
                background: #6b8e23;
                color: white;
                box-shadow: 0 4px 10px rgba(107, 142, 35, 0.3);
            }

            .action-btn.create:hover {
                background: #5c7c1f;
                transform: translateY(-2px);
            }

            .follow-stats-box {
                display: flex;
                justify-content: center;
                gap: 40px;
                background: #d9d9d9;
                padding: 12px;
                border-radius: 12px;
                margin-bottom: 20px;
                text-align: center;
            }

            .follow-stats-box p {
                margin: 0;
                font-size: 0.95rem;
                color: #2f3e2e;
                min-width: 110px;
            }

            .follow-stats-box strong {
                font-size: 1.2rem;
                color: #6b8e23;
            }

            .section-title {
                font-size: 1.3rem;
                margin: 20px 0 10px;
                font-weight: bold;
                color: #2f3e2e;
            }

            .tweet-box {
                background: #f9f9f9;
                padding: 15px;
                border-radius: 15px;
                border: 1px solid #e0e0e0;
                margin-bottom: 12px;
                font-size: 0.95rem;
                color: #2b2b2b;
                line-height: 1.5;
                box-shadow: 0 4px 10px rgba(0,0,0,0.06);
                transition: 0.2s ease;
            }

            .tweet-box:hover {
                transform: translateY(-2px);
                box-shadow: 0 8px 18px rgba(0,0,0,0.10);
                background: #f0f0f0;
            }

            .like-zone {
                display: flex;
                align-items: center;
                gap: 8px;
                margin-top: 8px;
            }

            .like-icon {
                font-size: 20px;
                text-decoration: none;
                transition: 0.2s ease;
            }

            .like-icon:hover {
                transform: scale(1.1);
            }

            .like-count {
                font-size: 0.95rem;
                color: #6b8e23;
                font-weight: 600;
            }

            .empty-state {
                margin-top: 15px;
                font-style: italic;
                color: #2f3e2e;
                text-align: center;
            }
        </style>

    {% endblock %}
{% endblock %}
