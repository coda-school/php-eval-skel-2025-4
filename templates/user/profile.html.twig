{% extends 'base.html.twig' %}

{% block body %}
    {% block content %}

<div class="profile-container">

    <h1>Profil de {{ user.pseudo }}</h1>

    {% if app.user and app.user != user %}
        {% if app.user.isFollowing(user) %}
            <a href="{{ path('user_unfollow', { id: user.id }) }}" class="unfollow-btn">
                Se désabonner
            </a>
        {% else %}
            <a href="{{ path('user_follow', { id: user.id }) }}" class="follow-btn">
                S'abonner
            </a>
        {% endif %}
    {% endif %}

    <div class="follow-stats">
        <p><strong>{{ user.followers|length }}</strong> abonnés</p>
        <p><strong>{{ user.following|length }}</strong> abonnements</p>
    </div>

    {% if app.user and app.user == user %}
        <div>
            <a href="{{ path('app_create') }}" class="create-btn">Créer un kweek</a>
        </div>
    {% endif %}


    <h2>Kweeks</h2>

    {% for post in posts %}
        <div class="tweet">
            {{ post.ContenuDuKweek }}

{#            <div class="like-zone">#}
{#                {% if app.user %}#}
{#                    {% if post.isLikedBy(app.user) %}#}
{#                        <a href="{{ path('post_like', { id: post.id, from: 'profile', userId: user.id }) }}" class="unlike-btn">❤️</a>#}
{#                    {% else %}#}
{#                        <a href="{{ path('post_like', { id: post.id, from: 'profile', userId: user.id }) }}" class="like-btn">🤍</a>#}
{#                    {% endif %}#}
{#                {% endif %}#}

{#                <span class="like-count">{{ post.likes|length }}</span>#}
{#            </div>#}
        </div>
    {% else %}
        <p>Aucun kweek pour le moment.</p>
    {% endfor %}


</div>


        <style>
            /* --- CONTAINER --- */
            .profile-container {
                max-width: 650px;
                margin: 40px auto;
                padding: 30px;
                background: #ffffff;
                border-radius: 18px;
                border: 2px solid #dcdcdc;
                box-shadow: 0 8px 20px rgba(0,0,0,0.08);
                font-family: "Inter", sans-serif;
            }

            /* --- TITLE --- */
            .profile-container h1 {
                font-size: 30px;
                font-weight: 800;
                margin-bottom: 15px;
                color: #3a3a3a;
                letter-spacing: -0.5px;
            }

            /* --- BUTTONS --- */
            .follow-btn,
            .unfollow-btn {
                display: inline-block;
                padding: 10px 20px;
                border-radius: 12px;
                font-weight: 600;
                text-decoration: none;
                font-size: 15px;
                transition: 0.25s ease;
            }

            .create-btn {
                display: inline-block;
                margin-bottom: 20px;
                padding: 10px 20px;
                background: #6b8e23; /* kaki */
                color: white;
                border-radius: 12px;
                font-weight: 600;
                text-decoration: none;
                font-size: 15px;
                transition: 0.25s ease;
                box-shadow: 0 4px 10px rgba(107, 142, 35, 0.3);
            }

            .create-btn:hover {
                background: #5c7c1f;
                transform: translateY(-2px);
            }

            /* Follow = KAKI VIF */
            .follow-btn {
                background: #6b8e23; /* kaki */
                color: white;
                box-shadow: 0 4px 10px rgba(107, 142, 35, 0.3);
            }

            .follow-btn:hover {
                background: #5c7c1f;
                transform: translateY(-2px);
            }

            /* Unfollow = ORANGE VIF */
            .unfollow-btn {
                background: #ff7b00;
                color: white;
                box-shadow: 0 4px 10px rgba(255, 123, 0, 0.3);
            }

            .unfollow-btn:hover {
                background: #e86e00;
                transform: translateY(-2px);
            }

            /* --- FOLLOW STATS --- */
            .follow-stats {
                display: flex;
                gap: 25px;
                margin: 25px 0;
            }

            .follow-stats p {
                margin: 0;
                padding: 12px 18px;
                background: #f4f4f4;
                border-radius: 12px;
                font-size: 15px;
                color: #444;
                border: 1px solid #e0e0e0;
            }

            .follow-stats strong {
                display: block;
                font-size: 22px;
                font-weight: 800;
                color: #6b8e23; /* kaki */
            }

            /* --- SECTION TITLE --- */
            h2 {
                font-size: 22px;
                margin: 25px 0 15px;
                font-weight: 700;
                color: #3a3a3a;
            }

            /* --- POST CARD --- */
            .tweet {
                background: #f9f9f9;
                padding: 18px;
                border-radius: 16px;
                border: 2px solid #e5e5e5;
                margin-bottom: 15px;
                font-size: 16px;
                color: #2b2b2b;
                line-height: 1.6;
                box-shadow: 0 6px 16px rgba(0,0,0,0.06);
                transition: 0.25s ease;
            }

            /* Hover dynamique */
            .tweet:hover {
                transform: translateY(-3px);
                box-shadow: 0 10px 24px rgba(0,0,0,0.10);
                background: #f0f0f0;
            }

            /* --- EMPTY STATE --- */
            .profile-container .empty {
                text-align: center;
                color: #777;
                font-style: italic;
                margin-top: 20px;
            }

            .like-zone {
                display: flex;
                align-items: center;
                gap: 8px;
                margin-top: 10px;
            }

            .like-btn, .unlike-btn {
                font-size: 20px;
                text-decoration: none;
                transition: 0.2s ease;
            }

            .like-btn:hover,
            .unlike-btn:hover {
                transform: scale(1.1);
            }

            .like-count {
                font-size: 16px;
                color: #6b8e23; /* kaki */
                font-weight: 600;
            }
        </style>

    {% endblock %}
{% endblock %}
