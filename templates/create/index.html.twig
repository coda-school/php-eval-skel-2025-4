{% extends 'base.html.twig' %}

{% block title %}Kwikker{% endblock %}

{% block body %}
    <style>
        :root {
            --frozen-water: #D7F9F1;
            --muted-teal:   #7AA095;
            --olive-leaf:   #40531B;
            --fern:         #618B4A;
            --dry-sage:     #AFBC88;
            --white:        #ffffff;
        }

        body {
            background-color: var(--frozen-water);
            font-family: "Inter", sans-serif;
            color: var(--olive-leaf);
        }

        .example-wrapper {
            margin: 50px auto;
            max-width: 600px;
            width: 95%;
            padding: 40px;
            background: var(--white);
            border-radius: 20px;
            box-shadow: 0 10px 30px rgba(64, 83, 27, 0.08);
            border: 1px solid var(--frozen-water);
        }

        #tweetInput {
            width: 100%;
            background-color: #FAFAFA;
            color: #333;
            border: 2px solid var(--dry-sage);
            padding: 15px;
            font-size: 16px;
            resize: vertical;
            outline: none;
            border-radius: 12px;
            min-height: 150px;
            font-family: inherit;
            transition: all 0.3s ease;
            box-sizing: border-box;
        }

        #tweetInput:focus {
            border-color: var(--fern);
            background-color: var(--white);
            box-shadow: 0 0 0 4px rgba(97, 139, 74, 0.15);
        }

        #charCount {
            color: var(--muted-teal);
            text-align: right;
            font-family: sans-serif;
            margin-top: 8px;
            font-weight: bold;
        }

        .button-post-create {
            display: block;
            width: 100%;
            margin-top: 20px;
            padding: 14px 20px;
            background-color: var(--fern);
            color: white;
            border: none;
            border-radius: 12px;
            cursor: pointer;
            font-weight: bold;
            font-size: 16px;
            transition: all 0.25s ease;
            box-shadow: 0 4px 10px rgba(97, 139, 74, 0.3);
        }

        .button-post-create:hover {
            background-color: var(--olive-leaf);
            transform: translateY(-2px);
        }
    </style>

    <div class="example-wrapper">
        {{ form_start(formulaire) }}

        {# On force l'ID 'tweetInput' ici #}
        {{ form_widget(formulaire.ContenuDuKweek, {
            'id': 'tweetInput',
            'attr': {
                'maxlength': '280'
            }
        }) }}

        <div style="color: #d93025; margin-bottom: 10px; font-weight: bold;">
            {{ form_errors(formulaire.ContenuDuKweek) }}
        </div>

        <div id="charCount">280 caractères restants</div>

        <button type="submit" class="button-post-create">Kwikker</button>

        {{ form_end(formulaire) }}
    </div>

    <script>
        document.addEventListener('DOMContentLoaded', () => {
            // On récupère les éléments
            const textarea = document.getElementById('tweetInput');
            const countDisplay = document.getElementById('charCount');

            // Debugging : Regarde dans la console (F12) si ces messages s'affichent
            if (!textarea) console.error("Erreur : Impossible de trouver la zone de texte #tweetInput");
            if (!countDisplay) console.error("Erreur : Impossible de trouver le compteur #charCount");

            if (textarea && countDisplay) {
                const updateCounter = () => {
                    const remaining = 280 - textarea.value.length;
                    countDisplay.innerText = `${remaining} caractères restants`;

                    if (remaining <= 20) {
                        countDisplay.style.color = "red";
                    } else {
                        countDisplay.style.color = "var(--muted-teal)";
                    }
                };

                textarea.addEventListener('input', updateCounter);

                // Initialisation au chargement
                updateCounter();
                console.log("Compteur initialisé avec succès !");
            }
        });
    </script>
{% endblock %}
